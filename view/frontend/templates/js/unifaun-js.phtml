                Object.keys(_define).forEach(function(key) {
                    // Copy all properties so RequireJS internals work
                    window.define[key] = _define[key];
                });

                // .amd is visible to everyone EXCEPT the Unifaun script
                Object.defineProperty(window.define, "amd", {
                    configurable: true,
                    get: function() {
                        if (document.currentScript === unifaunScript) {
                            return undefined;
                        }
                        return _define.amd;
                    }
                });

                node.addEventListener("load", function() {
                    window.define = _define;
                });
            }
        });
    });
});
unifaunObserver.observe(document, { childList: true, subtree: true });
